# Supabase 프로젝트 설정 → Project Settings → API 에서 확인
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kakao Developers(developers.kakao.com) 앱 등록 후 발급받는 REST API 키 (필수)
KAKAO_REST_API_KEY=

# Google Cloud Console에서 Geocoding API 활성화 후 발급받는 API 키 (지도 검색/역지오코딩용, 필수)
GOOGLE_MAPS_API_KEY=

# 앱 접근 비밀번호
APP_PASSWORD=
